# Dependencies
node_modules/
.venv/
venv/

# Build output
build/
dist/
dist-web/
coverage/
*.out
*.exe

# IDE / editor
.DS_Store
*.swp
*.swo
*~

# Environment / secrets
.env*
!.env.example
# Pi runtime data (sessions, package installs, cache). Project-shipped
# extensions + settings ARE source — un-ignore them explicitly.
.pi/sessions/
.pi/npm/
.pi/git/
.pi/cache.json
.pi/mcp-cache.json
**/auth.json

# Logs
*.log

# Python bytecode
*.pyc
__pycache__/

# Go binaries
backend/bin/
backend/cli
backend/main
backend/mcpserver
backend/orch
backend/orch-dev
backend/server
backend/tmp/

# Runtime data
data/
**/.pux/

# Org runtime data (5G+ of model weights, venvs, parsed dumps, memos).
# Org *templates* ship as AGENTS.md + .pi/agents/*.md — those ARE source.
# Use orgs/* (not orgs/) so per-org negations can win, then exclude
# everything inside each org except AGENTS.md.
orgs/*
!orgs/_demo/
!orgs/dev-bot/
!orgs/deep-research-engine/
!orgs/general/
!orgs/game-studio/
!orgs/invest/
!orgs/social-media-pipeline/
!orgs/telegram-agent/
!orgs/twitter-agent/
!orgs/video-production/
orgs/*/*
!orgs/*/AGENTS.md
!orgs/*/policy.yaml
# Org roster (specialist slugs) is SOURCE — a real config file, not runtime
# data. Must come after ``orgs/*/*`` so git tracks it. See feedback_orgs_gitignore_source_trap.
!orgs/*/org.yaml
# Per-org skills are SOURCE under the declarative contract (shipped as
# <org>/skills/<skill>/SKILL.md + references/ + scripts/), not runtime data —
# ship the whole skills/ tree. Must come after ``orgs/*/*`` and re-negate the
# dir so git descends into it; nothing under it matches a later ignore rule.
!orgs/*/skills/
# Per-org sandbox scripts (e.g. game-studio/sandbox/godot_client.py,
# deep-research-engine/sandbox/audio_client.py referenced by jobs:) are SOURCE
# too — ship the whole sandbox/ tree, same re-negation rationale as skills/.
!orgs/*/sandbox/

# Org-scoped runtime artifacts (article bodies, backtest outputs, parsed
# chat dumps, memos, etc.) — written by the agent during runs, not source.
artifacts/
**/artifacts/
**/workspace/
**/memos/
**/telegram_parsed.json
**/walkthrough_progress.json
**/INVEST-TRACKER.md

# Test artifacts
playwright-report/
test-results/

# Reference repos (cloned, not tracked)
reference/

# Sandbox / projects
projects/

# Browser-test cruft (one-off artifacts from Selenium/xdotool runs)
downloaded_files/
form.html

# Orphan venvs (root .venv/ is covered above; this catches siblings)
.venv-*/

# External research notes (system cards, design docs from outside the repo)
INSIGHTS-*.md

# Subagent default-output pollution — pi-subagents writes to project root
# when an agent's `output:` frontmatter is a bare filename. Operators should
# give explicit paths in task strings; this catches the leaks.
/brief.md
/draft.md
/manifest.md
/options.md
/research.md
/script.md
/test-report.md
/video-productions/


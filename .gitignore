# Dependencies
node_modules/
.venv/
venv/

# Build output
build/
dist/
dist-web/
coverage/
*.out
*.exe

# IDE / editor
.DS_Store
*.swp
*.swo
*~

# Environment / secrets
.env*
!.env.example
# Pi runtime data (sessions, package installs, cache). Project-shipped
# extensions + settings ARE source — un-ignore them explicitly.
.pi/sessions/
.pi/npm/
.pi/git/
.pi/cache.json
.pi/mcp-cache.json
**/auth.json

# Logs
*.log

# Python bytecode
*.pyc
__pycache__/

# Go binaries
backend/bin/
backend/cli
backend/main
backend/mcpserver
backend/orch
backend/orch-dev
backend/server
backend/tmp/

# Runtime data
data/
**/.pux/

# Org runtime data (5G+ of model weights, venvs, parsed dumps, memos).
# Org *templates* ship separately when the org-dispatch MCP surface lands.
orgs/
# Shipped org templates live under orgs/_demo/, orgs/<template>/ — these
# ARE source. The negation un-ignores them while keeping runtime org
# directories (which contain .pux/models/, venvs, etc) out of git.
!orgs/_demo/

# Org-scoped runtime artifacts (article bodies, backtest outputs, parsed
# chat dumps, memos, etc.) — written by the agent during runs, not source.
artifacts/
**/artifacts/
**/workspace/
**/memos/
**/telegram_parsed.json
**/walkthrough_progress.json
**/INVEST-TRACKER.md

# Test artifacts
playwright-report/
test-results/

# Reference repos (cloned, not tracked)
reference/

# Sandbox / projects
projects/

# Browser-test cruft (one-off artifacts from Selenium/xdotool runs)
downloaded_files/
form.html

# Orphan venvs (root .venv/ is covered above; this catches siblings)
.venv-*/

# External research notes (system cards, design docs from outside the repo)
INSIGHTS-*.md


# Dependencies
node_modules/
.venv/
venv/

# Build output
build/
dist/
dist-web/
coverage/
*.out
*.exe

# IDE / editor
.DS_Store
*.swp
*.swo
*~

# Environment / secrets
.env*
!.env.example
**/auth.json

# Logs
*.log

# Python bytecode
*.pyc
__pycache__/

# Go binaries
backend/bin/
backend/cli
backend/main
backend/mcpserver
backend/orch
backend/orch-dev
backend/server
backend/tmp/

# Runtime data — sessions, credentials, caches (written by skill scripts;
# see .deepagents/skills/*/scripts/paths.py)
data/
.cache/
# Dead pux runtime state (6.8G thread-store sqlite + logs from the deleted
# server lane). Kept on disk for the operator to reclaim manually; safe to
# `rm -rf .pux` once nothing needs the old thread history.
.pux/

# Run-scoped artifacts (article bodies, backtest outputs, parsed chat dumps,
# memos, etc.) — written by agents during runs, not source.
artifacts/
**/artifacts/
**/workspace/
**/memos/
**/telegram_parsed.json
**/walkthrough_progress.json
**/INVEST-TRACKER.md

# Test artifacts
playwright-report/
test-results/

# Reference repos (cloned, not tracked)
reference/

# Sandbox / projects
projects/

# Browser-test cruft (one-off artifacts from Selenium/xdotool runs)
downloaded_files/
form.html

# Orphan venvs (root .venv/ is covered above; this catches siblings)
.venv-*/

# External research notes (system cards, design docs from outside the repo)
INSIGHTS-*.md

# Subagent default-output pollution — pi-subagents writes to project root
# when an agent's `output:` frontmatter is a bare filename. Operators should
# give explicit paths in task strings; this catches the leaks.
/brief.md
/draft.md
/manifest.md
/options.md
/research.md
/script.md
/test-report.md
/video-productions/

# Internal planning docs

# Archives / backups (never track tarballs)
*.tar.gz
*.tar.bz2
*.tgz
*.zip


# Living notes on browser tool architecture + MCP swap decision
BROWSER-AI-CONTEXT.md

# Hard-won operator context — lessons beaten into Claude across sessions.
# Never commit; this is the local memory of what NOT to get wrong.
CLAUDE-CONTEXT.md

# Exports (not tracked)
export/

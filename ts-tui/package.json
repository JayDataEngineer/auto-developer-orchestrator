{
  "name": "orch-tui",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.tsx",
    "dev": "bun run --watch src/index.tsx",
    "build": "bun build src/index.tsx --outdir dist --target=bun",
    "typecheck": "bun run tsc --noEmit",
    "test": "bun test",
    "test:integration": "bun test src/app.integration.test.tsx"
  },
  "dependencies": {
    "ink": "5.2.0",
    "ink-spinner": "5",
    "ink-text-input": "5",
    "marked": "^15.0.11",
    "react": "18.3.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/react": "18.3.21",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.9.3"
  }
}

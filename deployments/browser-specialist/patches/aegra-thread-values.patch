+async def _latest_checkpoint_values(
+    thread: ThreadORM, user: User
+) -> dict[str, Any] | None:
+    """Latest checkpoint values for a thread, or None when unavailable.
+
+    Mirrors the state endpoint's snapshot read (threads.read access context —
+    never builds execution resources), best-effort: a failure to load state
+    must not fail the thread GET.
+    """
+    graph_id = (thread.metadata_json or {}).get("graph_id")
+    if not graph_id:
+        return None
+    try:
+        from aegra_api.services.langgraph_service import (
+            create_thread_config,
+            get_langgraph_service,
+        )
+
+        service = get_langgraph_service()
+        config: dict[str, Any] = create_thread_config(thread.thread_id, user)
+        async with service.get_graph(
+            graph_id, config=config, access_context="threads.read", user=user
+        ) as agent:
+            snapshot = await agent.with_config(config).aget_state(config)
+        vals = getattr(snapshot, "values", None)
+        return vals if isinstance(vals, dict) and vals else None
+    except Exception:
+        logger.warning(
+            "thread GET: could not load checkpoint values for %s",
+            thread.thread_id,
+            exc_info=True,
+        )
+        return None
 
 

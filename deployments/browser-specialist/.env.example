# browser-specialist deployment environment (copy to .env; never commit .env)
POSTGRES_PORT=5433
REDIS_PORT=6380
AUTH_TYPE=noop
HOST=127.0.0.1
PORT=2026

# the model the subagent runs on (OpenAI-compatible endpoint)
# same token the dcode pux-openai provider reads
ANTHROPIC_AUTH_TOKEN=

# optional model overrides
# BROWSER_SPECIALIST_MODEL=glm-5.2
# BROWSER_SPECIALIST_BASE_URL=https://api.z.ai/api/coding/paas/v4

# the OpenSandbox server the browser workload runs on (defaults shown)
# OPENSANDBOX_DOMAIN=localhost:8080
# OPENSANDBOX_API_KEY=

  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/main.tsx",
    "start": "bun run src/main.tsx",
    "test": "bun test",
    "postinstall": "node -e 'const fs=require(\"fs\"),p=\"node_modules/@pux/shared\";if(fs.existsSync(p)){const s=fs.lstatSync(p);if(s.isSymbolicLink())process.exit(0);fs.rmSync(p,{recursive:true})}fs.symlinkSync(\"../../shared\",p)' && node patches/apply.js"
  },
  "dependencies": {
    "@assistant-ui/react-ink": "^0.0.18",
    "@assistant-ui/react-ink-markdown": "^0.0.15",
    "@pux/shared": "file:../shared",
    "ink": "^6.0.0",
    "ink-scroll-view": "^0.3.7",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "bun-types": "latest",
    "ink-testing-library": "^4.0.0"
  }
}

[begin] (Pux Sandbox)
[exec] (Chrome) {/usr/bin/google-chrome-stable --no-first-run --no-default-browser-check --enable-features=WebContentsForceDark}
[exec] (File Browser) {pcmanfm /sandbox/workspace}
[exec] (Terminal) {xterm}
[separator]
[include] (~/.fluxbox/apps-menu)
[separator]
[exec] (Restart Chrome) {/usr/bin/google-chrome-stable --no-first-run --no-default-browser-check --enable-features=WebContentsForceDark &}
[exec] (Reload Menu) {/usr/local/bin/fluxbox-apps-menu.sh && fluxbox-remote reconfigure}
[separator]
[config] (Window Options)
[workspaces] (Workspace)
[separator]
[restart] (Restart Fluxbox)
[exit] (Exit)
[end]

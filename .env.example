# Auto-Developer Orchestrator Configuration

# ==============================================================================
# 1. CORE API KEYS
# ==============================================================================

# Required for Git operations & GitHub integration
GITHUB_TOKEN=your_github_pat_here

# ==============================================================================
# 2. LLM API KEYS
# ==============================================================================

# LLM providers (used by the harness model router)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# OpenRouter — gateway to MiMo-V2.5 multimodal (text+image) and others.
# Optional — dcode's model config lives in ~/.deepagents/config.toml.
# Get a key at https://openrouter.ai/.
OPENROUTER_API_KEY=

# Stream-chunk idle timer (optional). langchain-openai raises StreamChunkTimeoutError
# after this many seconds with NO SSE chunk. We DISABLE it (=0): glm-5.2 drives at
# `reasoning_effort: max` and a max-reasoning model has LEGITIMATE long silent gaps
# between chunks while it thinks — a chunk-idle deadline kills a live model
# mid-reasoning (false "stall" + editor freeze). Dead peers are still caught by
# kernel TCP keepalive (on by default) + the per-request timeout. Set >0 to re-enable.
# LANGCHAIN_OPENAI_STREAM_CHUNK_TIMEOUT_S=0

# ==============================================================================
# 3. INFRASTRUCTURE & SHARED SERVICES
# ==============================================================================

# Traefik Domain (default: local)
INFRA_DOMAIN=local
SHARED_NETWORK_NAME=shared-infra

# ==============================================================================
# 4. MCP TOOL SERVERS (upstream foreign servers)
# ==============================================================================
# Set these to the live endpoints of each MCP server (used by .mcp.json)
# before running `dcode` in the repo. They resolve the ${VAR} placeholders in
# the authored .mcp.json. A server whose variable is unset simply fails to
# activate; the rest still come up.

# research-mcp — web search, scrape, structured extraction
# Source: https://github.com/JayDataEngineer/research-mcp
MCP_WEB_RESEARCH_URL=

# equibles-mcp — SEC filings, holdings, insider/congressional trades, short data
# Source: https://github.com/daniel3303/Equibles
MCP_EQUIBLES_URL=

# surreal — SurrealDB built-in MCP server (3.1+). Started by `make infra`.
# For local dev: http://127.0.0.1:8000/mcp, auth=base64(root:root)=cm9vdDpyb290
MCP_SURREAL_URL=
MCP_SURREAL_AUTH=

# ray_inference — image/video generation pipelines (ComfyUI-style)
MCP_RAY_URL=

# media-mcp — audio/vision analysis. Started by `make infra`; the deep-research
# scripts default to http://localhost:8101, so set this only when it lives
# elsewhere (e.g. another tailnet host).
MEDIA_MCP_URL=

# nitter — READ-ONLY Twitter via direct GraphQL (twscrape). Bulk reads (search,
# user_tweets, replies, following) for twitter-agent; the browser MCP there
# handles writes. Built from infra/nitter/; opt-in via `make infra-nitter`
# (needs Twitter account credentials in infra/nitter/.env first).
# For local dev: http://127.0.0.1:41730/mcp.
MCP_NITTER_URL=

# Godot executable path (for godot-mcp-runtime stdio server)
# Source: https://github.com/Erodenn/godot-mcp-runtime
GODOT_PATH=


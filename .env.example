# Auto-Developer Orchestrator Configuration

# ==============================================================================
# 1. CORE API KEYS
# ==============================================================================

# Required for Git operations & GitHub integration
GITHUB_TOKEN=your_github_pat_here

# ==============================================================================
# 2. PI CODING AGENT CONFIGURATION
# ==============================================================================

# Pi agent config directory (session persistence)
PI_AGENT_DIR=~/.pi

# LLM API Keys (Pi supports multiple providers)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ==============================================================================
# 3. INFRASTRUCTURE & SHARED SERVICES
# ==============================================================================

# Traefik Domain (default: local)
INFRA_DOMAIN=local
SHARED_NETWORK_NAME=shared-infra

# Observability (Langfuse)
LANGFUSE_HOST=http://langfuse.local
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# ==============================================================================
# 4. NETWORK & PORTS (Defaults)
# ==============================================================================

# Go Backend
SERVER_PORT=3847
DATABASE_URL=../data/orchestrator.db
PROJECT_ROOT=../

# Frontend (Vite)
VITE_PORT=5174
VITE_API_URL=/api

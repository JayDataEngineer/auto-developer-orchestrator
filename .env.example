# Auto-Developer Orchestrator Configuration

# ==============================================================================
# 1. CORE API KEYS
# ==============================================================================

# Required for Git operations & GitHub integration
GITHUB_TOKEN=your_github_pat_here

# ==============================================================================
# 2. LLM API KEYS
# ==============================================================================

# LLM providers (used by the harness model router)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# OpenCode Zen — gateway to MiMo-V2.5 multimodal (text+image) and others.
# Used by the harness model router (harness/pux_harness/agent/model.py). Get a key at https://opencode.ai/.
OPENCODE_API_KEY=

# ==============================================================================
# 3. INFRASTRUCTURE & SHARED SERVICES
# ==============================================================================

# Traefik Domain (default: local)
INFRA_DOMAIN=local
SHARED_NETWORK_NAME=shared-infra

# Observability (Langfuse)
LANGFUSE_HOST=http://langfuse.local
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# ==============================================================================
# 4. MCP TOOL SERVERS (upstream foreign servers)
# ==============================================================================
# Set these to the live endpoints of each MCP server before running
# `pux serve|acp|direct`. Orgs opt in via policy.yaml tool_servers:.

# research-mcp — web search, scrape, structured extraction
# Source: https://github.com/JayDataEngineer/research-mcp
PUX_MCP_WEB_RESEARCH_URL=

# media-mcp — image, audio, video analysis
# Source: https://github.com/JayDataEngineer/media-mcp
PUX_MCP_MEDIA_URL=

# equibles-mcp — SEC filings, holdings, insider/congressional trades, short data
# Source: https://github.com/daniel3303/Equibles
PUX_MCP_EQUIBLES_URL=

# godot-ai — Godot engine MCP server (120+ ops, editor addon)
# Source: https://github.com/hi-godot/godot-ai
PUX_MCP_GODOT_AI_URL=

# Godot executable path (for godot-mcp-runtime stdio server)
# Source: https://github.com/Erodenn/godot-mcp-runtime
GODOT_PATH=

# ==============================================================================
# 5. NETWORK & PORTS (Defaults)
# ==============================================================================

# Backend
SERVER_PORT=3847
DATABASE_URL=../data/orchestrator.db
PROJECT_ROOT=../

# Frontend (Vite)
VITE_PORT=5174
VITE_API_URL=/api

# Nitter MCP — read-only Twitter via direct GraphQL (twscrape)
# ============================================================
# Copy to .env and edit. The .env file is gitignored (matches .gitignore:21
# .env* rule). Never commit real Twitter credentials.
#
# HOW TO POPULATE:
# 1. Open Twitter in a logged-in browser session.
# 2. DevTools → Application → Cookies → .x.com → copy `auth_token` and `ct0`.
# 3. Fill in the six vars per account below.
#
# At least one account is required. Multiple accounts spread rate limits
# (twscrape's pool round-robins across them). The alphanumeric suffix
# (_CEMRESGDX_, _NARON2O_, etc.) is just a grouping key — use any uppercase
# label unique per account.

# ---- Account 1 ----
NITTER_ACCOUNT_USER1_USERNAME=your_handle
NITTER_ACCOUNT_USER1_EMAIL=you@example.com
NITTER_ACCOUNT_USER1_PASSWORD=your_twitter_password
NITTER_ACCOUNT_USER1_EMAIL_PASSWORD=your_email_password
NITTER_ACCOUNT_USER1_AUTH_TOKEN=deadbeef...40_hex_chars
NITTER_ACCOUNT_USER1_CT0=deadbeef...160_hex_chars

# ---- Account 2 (optional — uncomment to enable) ----
# NITTER_ACCOUNT_USER2_USERNAME=other_handle
# NITTER_ACCOUNT_USER2_EMAIL=other@example.com
# NITTER_ACCOUNT_USER2_PASSWORD=other_twitter_password
# NITTER_ACCOUNT_USER2_EMAIL_PASSWORD=other_email_password
# NITTER_ACCOUNT_USER2_AUTH_TOKEN=...
# NITTER_ACCOUNT_USER2_CT0=...

# ---- Server config (all optional — defaults shown) ----
# Bind address + port. The compose service maps this to host 127.0.0.1:41730.
# NITTER_HOST=0.0.0.0
# NITTER_PORT=41730

# twscrape SQLite DB path. Mounted as a docker volume for persistence —
# keeps the login cache across container restarts so we don't re-auth.
# NITTER_DB_PATH=/data/accounts.db

# Per-request HTTP timeout for upstream Twitter GraphQL calls.
# NITTER_TWITTER_TIMEOUT_S=30.0

# Hard ceiling on any tool's `limit` argument. Default 200 = ~10 GraphQL pages.
# NITTER_MAX_LIMIT=200

# Set to `true` to allow the service to start with zero accounts configured
# (all tool calls return a clear error). Useful for first-time bring-up
# diagnostics. Production should leave this unset/false.
# NITTER_ALLOW_NO_ACCOUNTS=false

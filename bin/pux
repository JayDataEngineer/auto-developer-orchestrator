#!/usr/bin/env bash
# pux — routes to the deepagents harness (Python/uv).
#   pux direct ...         in-process runner (python -m pux_harness.main); no server
#   pux acp [--org X]      ACP stdio server (python -m pux_harness.acp); editor = TUI
#   pux mcp                MCP server wrapping the Agent Protocol REST API (SSE on :9987)
#   pux sandbox <cmd>      Docker sandbox lifecycle (start/stop/status/ensure)
#   pux <subcommand> ...   Agent Protocol client (python -m pux_harness.cli)
#
# Replaces the deleted TS launcher (bin/pux.mjs). The Agent Protocol server
# (prod: Aegra via scripts/start_pux_aegra.sh; dev: `langgraph dev` / `aegra dev`)
# is the canonical executor; client subcommands require it running.
set -euo pipefail
# resolve symlinks (e.g. ~/.local/bin/pux -> repo/bin/pux) before computing paths
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
REPO="$(cd "$HERE/.." && pwd)"

if [[ -f "$REPO/.env" ]]; then set -a; . "$REPO/.env"; set +a; fi

# Editors (Zed, VS Code) spawn this with a minimal PATH that often omits
# ~/.local/bin — where uv + the `pux` symlink live. Prepend it so `uv run`
# always resolves regardless of the caller's PATH. This is the ONE line that
# used to live only in scripts/acp-zed.sh; now bin/pux is self-sufficient for
# editor launches, so Zed calls `pux` by name (no absolute path anywhere).
export PATH="${HOME}/.local/bin:${PATH}"

# Pin the APP root for the harness: ``orgs/`` + ``.pux/`` + ``AGENTS.md`` live
# at the orchestrator repo, regardless of where the ``pux_harness`` package is
# physically installed. ``$PUX_PROJECT_ROOT`` is the ONE seam the kit's resolver
# reads; without it the harness would default to the CWD and miss the orgs.
export PUX_PROJECT_ROOT="$REPO"

# Capture the CALLER's CWD as the project to edit BEFORE we cd into $REPO below.
# ``PUX_PROJECT_PATH`` is what the sandbox bind-mounts at /sandbox/workspace —
# i.e. what the agent reads/writes. ``resolve_project_path()`` falls back to
# ``$PUX_PROJECT_ROOT`` (this repo) when it's unset, so without this capture a
# ``pux acp``/``pux direct`` launched from ANY other project would silently edit
# the orchestrator's own files. Honor an explicit override; else pin to CWD.
export PUX_PROJECT_PATH="${PUX_PROJECT_PATH:-$PWD}"

# Run from ``$REPO`` so ``uv run`` resolves the orchestrator workspace venv
# (which installs pux-harness as a member) — no per-subcommand ``cd`` needed.
cd "$REPO"

cmd="${1:-}"
case "$cmd" in
  direct)  shift; exec uv run python -m pux_harness.main "$@" ;;
  acp)     shift; exec uv run python -m pux_harness.acp "$@" ;;
  mcp)     shift; exec uv run python -m pux_harness.mcp_server "$@" ;;
  sandbox) shift; exec uv run python -m pux_harness.main --sandbox "$@" ;;
  "")
    echo "usage: pux <direct|acp|mcp|sandbox|agents|dispatch|resume|show|history|run|wait> ..." >&2
    exit 2 ;;
esac

exec uv run python -m pux_harness.cli "$@"

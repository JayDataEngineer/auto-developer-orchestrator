{
  "name": "auto-developer-orchestrator",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config src/web/vite.config.ts --host 0.0.0.0",
    "build": "vite build --config src/web/vite.config.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist-web",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "test:playwright:headed": "playwright test --headed",
    "test:playwright:debug": "playwright test --debug"
  },
  "dependencies": {
    "lit": "^3.3.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.14.0",
    "playwright": "^1.58.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^2.0.0"
  }
}

# Go Backend Development Dockerfile with Hot Reload + Pi Agent
FROM golang:1.26-alpine

WORKDIR /app

# Install dependencies
RUN apk add --no-cache git gcc musl-dev curl

# Install Node.js 22 for Pi coding agent
RUN apk add --no-cache nodejs npm && \
    npm install -g @mariozechner/pi-coding-agent@latest

# Install air for hot reload
RUN go install github.com/air-verse/air@v1.52.3

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Create data directory
RUN mkdir -p /data /app/projects

EXPOSE 3847

ENV SERVER_PORT=3847
ENV DATABASE_URL=/data/orchestrator.db
ENV GO_ENV=development

CMD ["air", "-c", ".air.toml"]

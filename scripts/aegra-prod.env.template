# Aegra prod runtime env TEMPLATE (phase B).
# Copy to a real env file (e.g. .pux/aegra-prod.env) and let start_pux_aegra.sh
# merge it with the project .env (which carries the secrets). Do NOT commit real
# secret values. Aegra reads aegra.json (PRIORITY over langgraph.json) and serves
# the REAL prod graph (build_graph + glm-5.2) — PUX_UPSTREAM_GRAPH is intentionally
# UNSET (runtime mode). This replaces server.py (sqlite) with Postgres.

# --- pux project ---
# PUX_PROJECT_ROOT is auto-derived by start_pux_aegra.sh (parent of scripts/).
# Set it here ONLY to override — e.g. when Aegra runs on a host separate from
# the project tree. The default is correct on any machine without editing.
# PUX_PROJECT_ROOT=/home/you/path/to/auto-developer-orchestrator
# PUX_UPSTREAM_GRAPH: leave UNSET for prod (runtime = build_graph + Docker
#   specialists + real model). Set to `org` or `keystone` ONLY for keyless smoke
#   (scripts/aegra_smoke.py).
AEGRA_CONFIG=aegra.json

# --- Aegra runtime ---
RUN_MIGRATIONS_ON_STARTUP=true
# HOST/PORT are set by start_pux_aegra.sh (bound to the Tailscale IP, path-
# transparent with server.py so consumers need no URL change on cutover).

# --- Postgres sidecar (scripts/aegra-prod.compose.yml) ---
POSTGRES_USER=pux_harness
POSTGRES_PASSWORD=pux_harness_secret
POSTGRES_DB=pux_harness
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Redis sidecar (run broker) ---
REDIS_BROKER_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0

# --- MCP server endpoints (sourced from the project .env, NOT here) ---
#   start_pux_aegra.sh sources the project .env which carries the PUX_MCP_*_URL
#   vars. Each maps to a tool_servers.yaml entry that orgs arm via capabilities.
#   An unset var → that org starts MCP-less for that server (ERROR log, not fatal).
#   PUX_MCP_WEB_RESEARCH_URL  — research-mcp (127.0.0.1:41827/mcp)
#   PUX_MCP_MEDIA_URL         — media-mcp    (127.0.0.1:41721/mcp)
#   PUX_MCP_EQUIBLES_URL      — equibles-mcp (127.0.0.1:43181/mcp)
#   PUX_MCP_SURREAL_URL       — SurrealDB MCP (127.0.0.1:8000/mcp)
#   PUX_MCP_RAY_URL           — Ray inference MCP (127.0.0.1:33080/mcp/ray/)
#                               list_models/describe_model/generate — the
#                               shared schema layer between Ray and agent
#                               runtimes. Armed for game-studio art-specialist.

# --- secrets (sourced from the project .env by start_pux_aegra.sh, NOT here) ---
#   ANTHROPIC_AUTH_TOKEN  (ZAI glm-5.2 — primary prod model)
#   OPENROUTER_API_KEY    (mimo/kimi/deepseek — OpenRouter, Parasail backend)
#   GITHUB_TOKEN, JULES_API_KEY, MCP_HUB_ENDPOINT, LANGFUSE_*, S3_* as needed

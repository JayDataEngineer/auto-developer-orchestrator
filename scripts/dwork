#!/usr/bin/env bash
# dwork — the coding lane on the local qwen model, opened in any folder.
#
#   dwork              # open in the current folder
#   dwork ~/my/project # open in a specific folder
#
# The folder IS the workspace: dcode's native git-root discovery applies
# there (union roster inside the repo, the folder's own .deepagents and
# .mcp.json otherwise). The coding lane's zero-MCP config and the local
# model ride along — the local model means no API keys, no rate limits,
# see qwen/README.md.
set -euo pipefail

REPO="/home/user/Documents/programs/vendor/dev/auto-developer-orchestrator"
PY="$HOME/.local/share/uv/tools/deepagents-code/bin/python"

cwd="${1:-$(pwd)}"

# The local provider just needs a key present (llama.cpp accepts any bearer
# token). The repo .env carries it; this fallback makes dwork unconditional.
export QWEN_API_KEY="${QWEN_API_KEY:-local-no-key}"

exec "$PY" "$REPO/profiles/run.py" coding -M local-qwen:qwen3.8-27b --cwd "$cwd"

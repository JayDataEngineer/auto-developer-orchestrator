{# sandbox.compose.yml.j2 — Docker Compose view of the org sandbox profile. #}
{# Renders only when org.toml has a [sandbox] block. #}
{# #}
{# Abstraction mapping (K8s CRD → Docker compose): #}
{#   SandboxTemplate   → this services.<name>-sandbox definition #}
{#   SandboxWarmPool   → scale: <warm_pool>  (kernel pre-starts N copies) #}
{#   SandboxClaim      → kernel allocates one container per task from the pool #}
{#   runtimeClassName  → runtime: <runtime_class_docker>  (runc|runsc|kata) #}
{#   resources.requests → deploy.resources.reservations #}
{#   resources.limits   → deploy.resources.limits #}
{#   build             → build: { context, dockerfile } #}
{#   volumes[]         → volumes: (bind|volume entries) + top-level volumes block #}
{#   networks[]        → networks: + top-level networks block #}
{#   healthcheck       → healthcheck: { test, interval, timeout, retries, start_period } #}
{# #}
{# All block tags live on their own lines so trim_blocks/lstrip_blocks don't #}
{# eat newlines after inline {% endif %}. #}
{# #}
{# Switching substrate to K8s later = re-render this template; org.toml stays. #}
# AUTO-GENERATED from org.toml — do not edit. Run `task org-build {{ name }}`.

services:
  {{ sandbox.service_name or (name ~ "-sandbox") }}:
{% if sandbox.build %}
    build:
      context: {{ sandbox.build.context | default(".") }}
      dockerfile: {{ sandbox.build.dockerfile | default("Dockerfile") }}
{% endif %}
{% if sandbox.image %}
    image: {{ sandbox.image }}
{% endif %}
{% if sandbox.container_name %}
    container_name: {{ sandbox.container_name }}
{% endif %}
{% if sandbox.runtime_class_docker %}
    runtime: {{ sandbox.runtime_class_docker }}
{% endif %}
{% if sandbox.restart %}
    restart: {{ sandbox.restart }}
{% endif %}
{% if sandbox.warm_pool and sandbox.warm_pool > 1 %}
    scale: {{ sandbox.warm_pool }}
{% endif %}
{% if sandbox.working_dir %}
    working_dir: {{ sandbox.working_dir }}
{% endif %}
{% if sandbox.command %}
    command: [{{ sandbox.command | map('tojson') | join(", ") }}]
{% endif %}
    # Labels that let Pux adopt this container instead of spinning up a
    # sibling. Bootstrap.sh exports OPENSHELL_PROJECT_PATH so the label
    # and the bind mount stay in sync — Pux's bash executor assumes
    # /sandbox/workspace maps to the project root.
    labels:
      openshell.org-name: "{{ name }}"
      openshell.project-path: "${OPENSHELL_PROJECT_PATH:-}"
      openshell.sandbox-id: "{{ name }}-compose"
      openshell.policy: "{{ sandbox.policy | default('developer') }}"
{% if sandbox.volumes %}
    volumes:
      # Canonical Pux mount — enables container reuse. When the env var
      # is unset, mounts the compose CWD (harmless default; Pux discovery
      # fails because the label is also empty, so no wrong adoption).
      - ${OPENSHELL_PROJECT_PATH:-./}:/sandbox/workspace
{% for v in sandbox.volumes %}
      - {{ (v.host if v.type == "bind" else v.name) ~ ":" ~ v.container }}
{% endfor %}
{% else %}
    volumes:
      - ${OPENSHELL_PROJECT_PATH:-./}:/sandbox/workspace
{% endif %}
{% if sandbox.env %}
    environment:
{% for k, v in sandbox.env.items() %}
      {{ k }}: "{{ v }}"
{% endfor %}
{% endif %}
{% if sandbox.resources.requests or sandbox.resources.limits %}
    deploy:
      resources:
{% if sandbox.resources.requests %}
        reservations:
          cpus: '{{ sandbox.resources.requests.cpu }}'
          memory: {{ sandbox.resources.requests.memory }}
{% endif %}
{% if sandbox.resources.limits %}
        limits:
          cpus: '{{ sandbox.resources.limits.cpu }}'
          memory: {{ sandbox.resources.limits.memory }}
{% endif %}
{% endif %}
{% if sandbox.healthcheck %}
    healthcheck:
      test: [{{ sandbox.healthcheck.test | map('tojson') | join(", ") }}]
{% if sandbox.healthcheck.interval %}
      interval: {{ sandbox.healthcheck.interval }}
{% endif %}
{% if sandbox.healthcheck.timeout %}
      timeout: {{ sandbox.healthcheck.timeout }}
{% endif %}
{% if sandbox.healthcheck.start_period %}
      start_period: {{ sandbox.healthcheck.start_period }}
{% endif %}
{% if sandbox.healthcheck.retries %}
      retries: {{ sandbox.healthcheck.retries }}
{% endif %}
{% endif %}
{% if sandbox.networks %}
    networks:
{% for n in sandbox.networks %}
      - {{ n.name }}
{% endfor %}
{% elif not sandbox.network_mode_disabled %}
    network_mode: host
{% endif %}

{% if sandbox.volumes %}
volumes:
{% for v in sandbox.volumes %}
{% if v.type != "bind" %}
  {{ v.name }}:
{% if v.docker_name %}
    name: {{ v.docker_name }}
{% endif %}
{% if v.external %}
    external: true
{% endif %}
{% endif %}
{% endfor %}
{% endif %}
{% if sandbox.networks %}
networks:
{% for n in sandbox.networks %}
  {{ n.name }}:
{% if n.docker_name %}
    name: {{ n.docker_name }}
{% endif %}
{% if n.external %}
    external: true
{% endif %}
{% endfor %}
{% endif %}

#!/usr/bin/env bash
# {{ org_name }} bootstrap — host-side, idempotent.
#
# Canonical 6-stage pattern (auto-generated from scripts/templates/org/bootstrap.sh.j2):
#   1. Hard dep check (fail-fast)
#   2. Soft dep warnings (continue)
#   3. --check early-exit
#   4. gVisor detection (write override if runsc absent)
#   5. docker compose up -d + 30s health-wait loop
#   6. In-container smoke test
#
# Usage:
#   ./bootstrap.sh                # full bootstrap
#   ./bootstrap.sh --check        # verify only, don't start anything
#   ./bootstrap.sh --down         # tear down what --check-less bootstrap brought up
{% if extra_flags %}
{% for flag in extra_flags %}
#   ./bootstrap.sh {{ flag.syntax }}    # {{ flag.help }}
{% endfor %}
{% endif %}

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# Canonical Pux mount + label — lets Pux adopt this container instead of
# spinning up a sibling. See [[feedback_container_reuse_label_discovery]].
export OPENSHELL_PROJECT_PATH="${OPENSHELL_PROJECT_PATH:-$SCRIPT_DIR}"

log()  { printf '[bootstrap] %s\n' "$*"; }
ok()   { printf '[bootstrap] ✓ %s\n' "$*"; }
err()  { printf '[bootstrap] ERROR: %s\n' "$*" >&2; }

# ── Args ──────────────────────────────────────────────────────────────────
CHECK_ONLY=0
DO_DOWN=0
case "${1:-}" in
  --check) CHECK_ONLY=1 ;;
  --down)  DO_DOWN=1 ;;
  "")      ;;
  *)       err "unknown arg: $1"; exit 1 ;;
esac

# ── --down: inverse of up ─────────────────────────────────────────────────
# Tears down the container + its network. Named volumes are PRESERVED
# (no `-v` flag) so data isn't lost across re-bootstraps. To wipe volumes
# too, run `docker compose down -v` manually.
if [ "$DO_DOWN" = "1" ]; then
  log "tearing down (docker compose down)"
  docker compose down
  ok "containers stopped"
  exit 0
fi

# ── 1. Hard deps ──────────────────────────────────────────────────────────
{% for dep in hard_deps %}
if ! {{ dep.check }} >/dev/null 2>&1; then
  err "{{ dep.error_msg }}"
  exit 1
fi
ok "{{ dep.name }} available"
{% endfor %}

# ── 2. Soft deps (warn only) ──────────────────────────────────────────────
{% for dep in soft_deps %}
if ! {{ dep.check }} >/dev/null 2>&1; then
  log "warning: {{ dep.name }} not reachable — {{ dep.warn_msg }}"
else
  ok "{{ dep.name }} reachable"
fi
{% endfor %}

# ── 3. --check early-exit ─────────────────────────────────────────────────
if [ "$CHECK_ONLY" = "1" ]; then
  log "--check requested; not starting container"
  exit 0
fi

# ── 4. gVisor detection ───────────────────────────────────────────────────
# Auto-generated compose requests `runtime: runsc` when org.toml declares
# runtime_class = "gvisor". Hosts without runsc installed choke on that
# line. Write a local override (gitignored) that strips it when missing.
if ! docker info 2>/dev/null | grep -i 'runtimes:' | grep -q runsc; then
  log "runsc not installed locally — writing docker-compose.override.yml to neutralize runtime line"
  cat > docker-compose.override.yml <<'EOF'
# Local override — strips `runtime: runsc` for hosts without gVisor.
# Auto-generated by bootstrap.sh; safe to delete.
services:
  {{ compose_service_name }}:
    runtime: ""
EOF
fi

# ── 5. Bring up the container ─────────────────────────────────────────────
log "starting sandbox (docker compose up -d)"
docker compose up -d

log "waiting for container to be running"
for i in $(seq 1 30); do
  if docker compose ps --status running --quiet | grep -q .; then
    ok "container running after ${i}s"
    break
  fi
  sleep 1
done

# ── 6. Smoke test ─────────────────────────────────────────────────────────
{% if smoke_test_command %}
log "smoke test: {{ smoke_test_description | default('in-container smoke test') }}"
if docker compose exec -T "{{ compose_service_name }}" {{ smoke_test_command }} >/dev/null 2>&1; then
  ok "smoke test passed"
else
  err "smoke test failed — check container logs: docker compose logs"
  exit 1
fi
{% endif %}

echo
echo "═══════════════════════════════════════════════════════════════"
echo "  {{ org_name }} bootstrap — COMPLETE"
echo "═══════════════════════════════════════════════════════════════"
echo "  Container:  {{ compose_service_name }} (restart: unless-stopped)"
echo "  Workspace:  $SCRIPT_DIR  (bind-mounted at /sandbox/workspace)"
echo
echo "  Tear down:  ./bootstrap.sh --down"
echo "═══════════════════════════════════════════════════════════════"

{# tool_package.yaml.j2 — renders one tool_packages/<name>.yaml per pkg. #}
{# Required context: pkg.{name, description}. Optional: tools, mcp_servers, #}
{# sandbox_tier. #}
# AUTO-GENERATED from org.toml — do not edit. Run `task org-build`.
description: "{{ pkg.description }}"
{% if pkg.tools %}
tools:
{% for t in pkg.tools %}  - {{ t }}
{% endfor %}{% endif %}
{% if pkg.mcp_servers %}
mcp_servers:
{% for m in pkg.mcp_servers %}  - {{ m }}
{% endfor %}{% endif %}
{% if pkg.sandbox_tier %}sandbox_tier: {{ pkg.sandbox_tier }}
{% endif %}
